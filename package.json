{
  "name": "qr-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "backend:serve": "php -S 127.0.0.1:8080 -t backend/public backend/public/router.php",
    "db:migrate": "php backend/bin/migrate.php",
    "db:import-legacy": "php backend/bin/import-legacy.php",
    "admin:hash": "php -r \"echo password_hash($argv[1], PASSWORD_DEFAULT), PHP_EOL;\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/three": "^0.186.0",
    "motion": "^13.4.4",
    "postprocessing": "^6.39.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
